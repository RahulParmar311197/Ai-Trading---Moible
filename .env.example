# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_trading

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=replace_me

# AI provider — leave URL empty to keep AI endpoints safely disabled
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=replace_me
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_SECONDS=20

# Broker integrations — fill only in local secret environment
DHAN_CLIENT_ID=replace_me
DHAN_SECRET=replace_me
UPSTOX_CLIENT_ID=replace_me
UPSTOX_SECRET=replace_me
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_ACCESS_TOKEN=

# Controlled execution — all values are required before the application
# composes an execution runtime. Configuration never activates trading.
EXECUTION_BROKER=
EXECUTION_SANDBOX=false
EXECUTION_ALLOW_LIVE_ORDERS=false
EXECUTION_ALLOW_SANDBOX_ORDERS=false
EXECUTION_CONFIRMATION_PHRASE=
TRADING_SESSION_ID=
EXECUTION_MAX_ORDER_NOTIONAL=
EXECUTION_MAX_POSITION_QUANTITY=
EXECUTION_MAX_DAILY_LOSS=
